# ==============================================================================
# Sylvan Grove (E-Comm) — Environment Configuration Template
# Copy to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (MySQL 8 + Prisma) ---
# Example: mysql://sylvangrove:password@localhost:3306/sylvan_grove?connection_limit=10
DATABASE_URL=
DATABASE_SSL_MODE=PREFERRED
DATABASE_POOL_SIZE=10

# Local sandbox fallback (ONLY for local preview/tests when MySQL 8 is not running; forbidden in production)
ALLOW_LOCAL_DEV_STORE=true

# --- Sessions & Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12

# --- Initial Admin Provisioning (Used ONLY by scripts/create-admin.js or prisma/seed.js) ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Orchard Administrator

# --- Store Currency & Market Settings ---
# Supported ISO codes: USD, INR
STORE_CURRENCY=USD
STORE_NAME=Sylvan Grove
FREE_SHIPPING_THRESHOLD=65
STANDARD_SHIPPING_FEE=6.95

# --- Temporary Payment: UPI QR Code (Enabled ONLY when STORE_CURRENCY=INR & VPA configured) ---
UPI_QR_ENABLED=false
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=
UPI_CURRENCY=INR
UPI_QR_EXPIRY_MINUTES=15

# --- Permanent Payment Gateway: Razorpay ---
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Permanent Payment Gateway: Stripe ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transactional Email (Resend or console logger) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Sylvan Grove <orders@sylvangrove.example>

# --- Image Storage (local | cloudinary | s3) ---
STORAGE_PROVIDER=local
MAX_IMAGE_UPLOAD_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
