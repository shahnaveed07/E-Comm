generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PLACED
  PACKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PENDING_MANUAL_VERIFICATION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  REJECTED
}

enum PaymentProvider {
  UPI_QR
  RAZORPAY
  STRIPE
  SAVED_CARD_TOKEN
  MANUAL_INVOICE
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
  REFUNDED
}

enum InventoryMovementType {
  RESTOCK
  RESERVE
  RELEASE
  COMMIT
  ADJUSTMENT
  RETURN
}

enum CouponDiscountType {
  PERCENT
  FIXED_MINOR
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique @db.VarChar(255)
  fullName            String    @db.VarChar(180)
  role                UserRole  @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  passwordHash        String    @db.VarChar(255)
  passwordAlgo        String    @default("bcrypt") @db.VarChar(32)
  passwordSalt        String?   @db.VarChar(128)
  emailVerifiedAt     DateTime? @db.Timestamp(3)
  verifyTokenHash     String?   @db.VarChar(128)
  verifyTokenExpiresAt DateTime? @db.Timestamp(3)
  resetTokenHash      String?   @db.VarChar(128)
  resetTokenExpiresAt DateTime? @db.Timestamp(3)
  createdAt           DateTime  @default(now()) @db.Timestamp(3)
  updatedAt           DateTime  @updatedAt @db.Timestamp(3)

  sessions            UserSession[]
  addresses           Address[]
  preference          CustomerPreference?
  savedPaymentMethods SavedPaymentMethod[]
  orders              Order[]
  reviews             Review[]
  payments            Payment[]             @relation("PaymentCustomer")
  verifiedPayments    Payment[]             @relation("PaymentVerifier")
  invoices            Invoice[]
  inventoryMovements  InventoryMovement[]
  statusChanges       OrderStatusHistory[]
  auditLogs           AuditLog[]
  returnRequests      ReturnRequest[]

  @@index([role, status])
  @@index([createdAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique @db.VarChar(128)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  expiresAt        DateTime  @db.Timestamp(3)
  revokedAt        DateTime? @db.Timestamp(3)
  lastSeenAt       DateTime  @default(now()) @db.Timestamp(3)
  createdAt        DateTime  @default(now()) @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("Home") @db.VarChar(60)
  fullName    String   @db.VarChar(180)
  street      String   @db.VarChar(255)
  city        String   @db.VarChar(120)
  state       String   @db.VarChar(80)
  postalCode  String   @db.VarChar(32)
  countryCode String   @default("US") @db.VarChar(2)
  phone       String   @default("") @db.VarChar(40)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(140)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                  String   @id @default(cuid())
  slug                String   @unique @db.VarChar(160)
  name                String   @db.VarChar(200)
  categoryId          String
  origin              String   @db.VarChar(160)
  harvestBatch        String   @db.VarChar(160)
  roastProfile        String   @db.VarChar(64)
  roastLabel          String   @db.VarChar(120)
  shortDescription    String   @db.Text
  tastingNotes        String   @db.Text
  nutritionPerServing Json
  dietaryTags         Json
  allergens           Json
  featuredTag         String?  @db.VarChar(80)
  isVisible           Boolean  @default(true)
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamp(3)
  updatedAt           DateTime @updatedAt @db.Timestamp(3)

  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([categoryId, isVisible, isArchived])
  @@index([roastProfile])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique @db.VarChar(80)
  weightSize        String   @db.VarChar(16)
  weightLabel       String   @db.VarChar(80)
  grams             Int
  currency          String   @default("USD") @db.VarChar(3)
  priceMinor        Int
  priceDecimal      Decimal  @db.Decimal(12, 2)
  stockQuantity     Int      @default(50)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(8)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamp(3)
  updatedAt         DateTime @updatedAt @db.Timestamp(3)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, weightSize])
  @@index([stockQuantity, reservedStock])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String   @db.VarChar(1024)
  storageKey String?  @db.VarChar(512)
  provider   String   @default("local") @db.VarChar(32)
  altText    String   @db.VarChar(255)
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamp(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  authorName       String   @db.VarChar(180)
  rating           Int
  title            String   @db.VarChar(200)
  comment          String   @db.Text
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  updatedAt        DateTime @updatedAt @db.Timestamp(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}

model CustomerPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredRoast     String   @default("raw_sprouted") @db.VarChar(64)
  dietaryGoals       Json
  excludedAllergens  Json
  wishlistProductIds Json?
  emailUpdates       Boolean  @default(true)
  smsDeliveryAlerts  Boolean  @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique @db.VarChar(64)
  userId            String?
  status            OrderStatus   @default(PLACED)
  paymentStatus     PaymentStatus @default(PENDING)
  isLive            Boolean       @default(true)
  source            String        @default("storefront") @db.VarChar(32)
  currency          String        @default("USD") @db.VarChar(3)
  subtotalMinor     Int
  shippingFeeMinor  Int
  discountMinor     Int           @default(0)
  totalMinor        Int
  totalDecimal      Decimal       @db.Decimal(12, 2)
  couponCode        String?       @db.VarChar(64)
  paymentSummary    String        @db.VarChar(160)
  trackingNumber    String        @db.VarChar(120)
  estimatedDelivery String?       @db.VarChar(32)
  notes             String?       @db.Text
  shippingAddress   Json
  placedAt          DateTime      @default(now()) @db.Timestamp(3)
  archivedAt        DateTime?     @db.Timestamp(3)
  updatedAt         DateTime      @updatedAt @db.Timestamp(3)

  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  invoices       Invoice[]
  statusHistory  OrderStatusHistory[]
  movements      InventoryMovement[]
  returnRequests ReturnRequest[]

  @@index([userId, placedAt])
  @@index([status, paymentStatus, isLive])
  @@index([placedAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  variantId           String?
  skuSnapshot         String   @db.VarChar(80)
  productNameSnapshot String   @db.VarChar(200)
  weightSize          String   @db.VarChar(16)
  weightLabel         String   @db.VarChar(80)
  currency            String   @default("USD") @db.VarChar(3)
  unitPriceMinor      Int
  unitPriceDecimal    Decimal  @db.Decimal(12, 2)
  quantity            Int
  lineTotalMinor      Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                  String          @id @default(cuid())
  orderId             String
  userId              String?
  provider            PaymentProvider
  status              PaymentStatus   @default(PENDING)
  currency            String          @default("USD") @db.VarChar(3)
  amountMinor         Int
  amountDecimal       Decimal         @db.Decimal(12, 2)
  refundedMinor       Int             @default(0)
  idempotencyKey      String          @unique @db.VarChar(128)
  paymentReference    String          @unique @db.VarChar(128)
  externalOrderId     String?         @db.VarChar(180)
  externalPaymentId   String?         @db.VarChar(180)
  upiUri              String?         @db.Text
  qrExpiresAt         DateTime?       @db.Timestamp(3)
  utrNumber           String?         @db.VarChar(64)
  utrSubmittedAt      DateTime?       @db.Timestamp(3)
  verifiedByUserId    String?
  verifiedAt          DateTime?       @db.Timestamp(3)
  verificationNotes   String?         @db.Text
  rejectionReason     String?         @db.Text
  providerMetadata    Json?
  createdAt           DateTime        @default(now()) @db.Timestamp(3)
  updatedAt           DateTime        @updatedAt @db.Timestamp(3)

  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User?  @relation("PaymentCustomer", fields: [userId], references: [id], onDelete: SetNull)
  verifiedByUser User?  @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([utrNumber])
  @@index([provider, status])
  @@index([externalOrderId])
  @@index([externalPaymentId])
}

model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  eventId        String          @db.VarChar(180)
  eventType      String          @db.VarChar(120)
  signatureValid Boolean
  status         String          @default("PROCESSED") @db.VarChar(40)
  payload        Json
  processedAt    DateTime        @default(now()) @db.Timestamp(3)

  @@unique([provider, eventId])
  @@index([processedAt])
}

model SavedPaymentMethod {
  id             String   @id @default(cuid())
  userId         String
  provider       String   @default("CARD_TOKEN") @db.VarChar(32)
  tokenRef       String   @db.VarChar(180)
  brand          String   @db.VarChar(40)
  last4          String   @db.VarChar(4)
  expMonth       String   @db.VarChar(2)
  expYear        String   @db.VarChar(4)
  cardholderName String   @db.VarChar(180)
  billingZip     String   @db.VarChar(24)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Invoice {
  id                   String        @id @default(cuid())
  invoiceNumber        String        @unique @db.VarChar(64)
  orderId              String
  userId               String?
  description          String        @db.VarChar(255)
  currency             String        @default("USD") @db.VarChar(3)
  subtotalMinor        Int
  shippingFeeMinor     Int
  discountMinor        Int           @default(0)
  totalMinor           Int
  amountDecimal        Decimal       @db.Decimal(12, 2)
  status               InvoiceStatus @default(UNPAID)
  paymentMethodSummary String        @db.VarChar(160)
  issuedAt             DateTime      @default(now()) @db.Timestamp(3)
  paidAt               DateTime?     @db.Timestamp(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
  @@index([orderId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  orderId       String?
  actorUserId   String?
  type          InventoryMovementType
  quantityDelta Int
  balanceAfter  Int
  reservedAfter Int
  reason        String                @db.VarChar(255)
  createdAt     DateTime              @default(now()) @db.Timestamp(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  note        String?      @db.VarChar(255)
  createdAt   DateTime     @default(now()) @db.Timestamp(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique @db.VarChar(64)
  description      String             @db.VarChar(255)
  discountType     CouponDiscountType
  discountValue    Int
  currency         String             @default("USD") @db.VarChar(3)
  minOrderMinor    Int                @default(0)
  maxDiscountMinor Int?
  usageLimit       Int?
  usedCount        Int                @default(0)
  isActive         Boolean            @default(true)
  expiresAt        DateTime?          @db.Timestamp(3)
  createdAt        DateTime           @default(now()) @db.Timestamp(3)

  @@index([code, isActive])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String   @db.VarChar(32)
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String   @db.VarChar(128)
  ipAddress   String?  @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model StoreSetting {
  id              String   @id @default(cuid())
  key             String   @unique @db.VarChar(120)
  value           Json
  description     String?  @db.VarChar(255)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt @db.Timestamp(3)
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  reason      String       @db.Text
  status      ReturnStatus @default(REQUESTED)
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now()) @db.Timestamp(3)
  updatedAt   DateTime     @updatedAt @db.Timestamp(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId, status])
}

model NotificationJob {
  id           String    @id @default(cuid())
  channel      String    @default("email") @db.VarChar(32)
  recipient    String    @db.VarChar(255)
  template     String    @db.VarChar(80)
  subject      String    @db.VarChar(255)
  payload      Json
  status       String    @default("PENDING") @db.VarChar(32)
  attempts     Int       @default(0)
  lastError    String?   @db.Text
  scheduledAt  DateTime  @default(now()) @db.Timestamp(3)
  processedAt  DateTime? @db.Timestamp(3)

  @@index([status, scheduledAt])
}
